# =====================================================================
#  Claves del proyecto Mejoland - PLANTILLA (sin valores)
#  Copiar este archivo como "claves.env" (git lo ignora) y completarlo solo en el equipo local.
#  Los scripts las piden por teclado si la variable no existe.
# =====================================================================

# 01-red/cisco/00-seguridad-ssh-comun.txt  (reemplazar <CLAVE_ADMIN> y <CLAVE_ENABLE> al pegar)
CLAVE_ADMIN=
CLAVE_ENABLE=

# 02-servidores/srv-aaa-1/01-configurar-aaa1.sh  (secreto RADIUS compartido con routers, switches y AP)
RADIUS_SECRETO=

# 02-servidores/comun/cambiar-claves.sh  (clave comun de servicios, minimo 10 caracteres)
CLAVE_NUEVA=

# 02-servidores/srv-monitoreo/04-zabbix-seguridad.py  (usuario Admin de Zabbix)
ZABBIX_CLAVE=

# 04-pruebas/esfuerzo/carga-edunova.js  (clave de las cuentas de prueba; la crea crear-datos-prueba.sh)
CLAVE=

# Las demas claves (MariaDB, LDAP, replica, GLPI, Nextcloud) las GENERAN los scripts al instalar
# y quedan en /root/proyecto/claves*.txt de cada servidor (permisos 600). El token de Centinela
# lo crea iniciar-centinela.bat / instalar-centinela-fedora.sh en token.txt.
